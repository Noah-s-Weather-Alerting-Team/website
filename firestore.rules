rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /botStatus/current {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email == 'noahkonrad4@gmail.com'
        && request.resource.data.keys().hasOnly(['status', 'message', 'updatedAt'])
        && request.resource.data.keys().hasAll(['status', 'message', 'updatedAt'])
        && request.resource.data.status in ['online', 'offline', 'maintenance', 'restarting']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.updatedAt is timestamp;
    }

    match /siteContent/published {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email == 'noahkonrad4@gmail.com'
        && request.resource.data.keys().hasOnly([
          'noahsOutlooks', 'ecccOutlooks', 'updates', 'announcements', 'media'
        ])
        && request.resource.data.keys().hasAll([
          'noahsOutlooks', 'ecccOutlooks', 'updates', 'announcements', 'media'
        ])
        && request.resource.data.noahsOutlooks is list
        && request.resource.data.ecccOutlooks is list
        && request.resource.data.updates is list
        && request.resource.data.announcements is list
        && request.resource.data.media is list;
    }
  }
}
